# Model providers. LiteLLM reads whichever of these matches the --model prefix you pass.
# You only need the one you intend to run against.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Point LiteLLM at a local Ollama server instead, and spend nothing.
# OLLAMA_API_BASE=http://localhost:11434

# Results API. Reads are public, writes need this key.
TRAJECTORY_API_KEY=change-me-before-you-deploy
TRAJECTORY_API_URL=http://localhost:8000

# Postgres. docker compose up db gives you this exact URL locally.
DATABASE_URL=postgresql+psycopg://trajectory:trajectory@localhost:5432/trajectory

# API behaviour. Only DATABASE_URL and TRAJECTORY_API_KEY are required: the service
# refuses to start without them rather than accepting requests it cannot serve.
TRAJECTORY_CORS_ORIGINS=http://localhost:3000
TRAJECTORY_LOG_FORMAT=console
TRAJECTORY_LOG_LEVEL=INFO
TRAJECTORY_RATE_LIMIT_WRITES_PER_MINUTE=30
TRAJECTORY_MAX_BUNDLE_RUNS=200
TRAJECTORY_DB_POOL_SIZE=5
# Public URL of the deployed service, used in the OpenAPI servers list.
TRAJECTORY_PUBLIC_BASE_URL=

# Web app. Leave unset to build the static demo against fixtures/recorded-runs.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Opt in to the unsandboxed local backend. Required for task authoring on a machine
# without Docker. Runs produced this way are stamped sandbox_backend=local and are
# rejected by the results API leaderboard.
# TRAJECTORY_ALLOW_LOCAL_SANDBOX=1
